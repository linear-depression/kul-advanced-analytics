# ── LLM Model Configuration ──────────────────────────────────────
# Set LLM_MODEL to the provider/model string that LiteLLM expects.
# Only one LLM_MODEL line should be uncommented at a time.

# Local (Ollama, no API key needed — default)
LLM_MODEL=ollama/qwen3.5:9b

# DeepSeek
# LLM_MODEL=deepseek/deepseek-v4-flash
# LLM_MODEL=deepseek/deepseek-v4-pro
# DEEPSEEK_API_KEY=your_key_here

# Google Gemini
# LLM_MODEL=gemini/gemini-3.5-flash
# GEMINI_API_KEY=your_key_here

# Zhipu AI
# LLM_MODEL=zhipu/glm-5.1
# ZHIPUAI_API_KEY=your_key_here

# Minimax
# LLM_MODEL=minimax/minimax-m2.7
# MINIMAX_API_KEY=your_key_here

# Moonshot (Kimi)
# LLM_MODEL=moonshot/kimi-k2.6
# MOONSHOT_API_KEY=your_key_here
